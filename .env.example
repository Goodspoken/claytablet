# PopyCast (ClayTablet) Environment Configuration
# Copy this file to .env and adjust the values for your setup

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------

# The public URL where this instance will be hosted (e.g., https://my-clipboard.com or http://192.168.1.100)
# This is used for generating correct QR codes and OAuth callbacks.
HOST_URL=http://localhost:8000

# Allowed CORS origins (comma-separated). Add your domain here.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,https://claytablet.online

# Environment type: 'production' or 'development'
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------

# Secret key used for signing JWT tokens. 
# GENERATE A STRONG RANDOM STRING FOR PRODUCTION!
JWT_SECRET=change-me-in-production-to-a-long-random-string

# ------------------------------------------------------------------------------
# OAuth Configuration (Optional)
# ------------------------------------------------------------------------------
# Leave these blank if you do not want to enable Google/Yandex login

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Monitoring (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=
