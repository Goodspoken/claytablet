# DubTab Backend Environment Variables

# Production Host URL (for OAuth callbacks)
HOST_URL=https://dubtab.app

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://dubtab.app,http://localhost:5173,http://localhost:3000

# Secret for JWT signing
JWT_SECRET=your-super-secret-key-here

# Database and media storage directory
DATA_DIR=/app/data

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
