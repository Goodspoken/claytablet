{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClayTablet",
  "version": "0.1.0",
  "identifier": "online.claytablet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClayTablet",
        "width": 1100,
        "height": 750,
        "minWidth": 600,
        "minHeight": 400,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MDA4NjI5OTVEMjRGNkQKUldSdFQ5S1ZLWVlBbDQyd1JkL3g0UTJIekZwUWZ3K0pFVlU1b1ZvT1RjNE9yb0x0MlgzdVE3alAK",
      "endpoints": [
        "https://github.com/Goodspoken/claytablet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installerArgs": ["/S"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
