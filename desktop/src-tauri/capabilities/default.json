{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and quick-paste windows",
  "windows": ["main", "quick-paste"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-delete",
    "store:allow-load",
    "store:allow-clear",
    "store:allow-keys",
    "notification:default",
    "global-shortcut:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "fs:allow-read-file",
    "shell:allow-open",
    "updater:default",
    "process:default"
  ]
}
